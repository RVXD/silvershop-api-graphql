{
    "name": "silvershop/api-graphql",
    "description": "GraphQL overlay for silvershop/api (SilverStripe CMS 6): a public /graphql schema for the SilverShop catalog, cart, checkout hand-off, orders and customer self-service — reusing the REST base's token auth, scopes and serializers. Thin by design: auth middleware + a handful of resolvers + schema config.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "api", "graphql", "headless"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-api-graphql/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silverstripe/graphql": "^6.1",
        "silvershop/core": "^6",
        "silvershop/api": "dev-main"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/silvershop-suite/silvershop-api.git"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Api\\GraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Api\\GraphQL\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
